# ==============================================================================
# 🛰 ANTIGRAVITY IDE TELEGRAM BRIDGE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Скопируйте этот файл в `.env` и укажите ваши персональные данные:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ (REQUIRED)
# ------------------------------------------------------------------------------

# 🤖 Токен вашего Telegram-бота, полученный у @BotFather:
TG_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 🔒 Безопасность: разрешенные пользователи Telegram (username или числовой ID):
ALLOWED_USERNAMES="your_username_here"
ALLOWED_CHAT_IDS="123456789"

# ------------------------------------------------------------------------------
# 2. ПАРАМЕТРЫ СЕТИ И СЕРВЕРА (NETWORK & BRIDGE)
# ------------------------------------------------------------------------------

# 🌐 Локальный порт приёмника хуков между мостом и IDE (default: 8080):
RECEIVER_PORT=8080

# ------------------------------------------------------------------------------
# 3. ОПЦИОНАЛЬНЫЕ ПАРАМЕТРЫ (OPTIONAL)
# ------------------------------------------------------------------------------

# 🔑 Google Gemini API Key (Опционально: нужен ТОЛЬКО для автономного режима без IDE):
# Для работы в качестве зеркала сессии Antigravity IDE ключ НЕ требуется!
GEMINI_API_KEY=""

# 🎙 Настройки локального голоса и распознавания речи (OmniVoice / Faster-Whisper):
VOICE_NAME="default"
WHISPER_LANGUAGE="ru"
WHISPER_MODEL="large-v3-turbo"
